+void test_body_limit() {
+    ap::airplay::Request request;
+    require(request.content_length() == 0, "missing Content-Length is an empty body");
+    request.headers["content-length"] = "68";
+    require(request.content_length() == 68, "plain Content-Length is accepted");
+    for (const char* bad : {"-1", "99999999999999999999", "12abc", "0x10"}) {
+        request.headers["content-length"] = bad;
+        require(request.content_length() > ap::airplay::kMaxBodySize, "malformed or huge Content-Length is rejected");
+    }
+
+    std::atomic<int> rejected{0};
+    ap::net::TcpServer server;
+    require(server.start(0, [&](ap::net::ClientSocket client) {
+        ap::airplay::RequestReader reader(client.cancelled);
+        ap::airplay::Request req;
+        if (!reader.read(client.fd, req)) ++rejected;
+    }), "body limit server");
+    const socket_t client = connect_to(server.port());
+    const std::string oversized = "POST /fp-setup RTSP/1.0\r\nContent-Length: 4294967295\r\n\r\n";
+    require(ap::net::send_all(client, oversized.data(), static_cast<int>(oversized.size())) > 0, "send oversized request");
+    wait_for([&] { return rejected.load() == 1; });
+    check_closed(client);
+    server.stop();
+}
