+        if (sock_ == INVALID_SOCKET) return false;
+        const BOOL on = TRUE;
+        ::setsockopt(sock_, SOL_SOCKET, SO_REUSEADDR, reinterpret_cast<const char*>(&on), sizeof(on));
+        sockaddr_in any{};
+        any.sin_family = AF_INET;
+        any.sin_port = htons(5353);
